# Database Configuration
DB_USER=heyes_user
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=heyes

# Database SSL Certificate (optional, only for production with custom CA)
# If your database provider uses a self-signed certificate, provide the CA certificate here
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\nYour CA Certificate\n-----END CERTIFICATE-----

# Environment
NODE_ENV=development

# JWT Secret - IMPORTANT: Generate a secure random string
# Use this command to generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_secure_jwt_secret_here_replace_with_random_string

# Server Port (optional, defaults to 5000)
PORT=5000
